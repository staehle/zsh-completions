# Custom hackery to support platform and append completion in zsh
__bitbq_platform_selector() {
    local platforms appends
    local -a platform_list append_list

    if ! command -v bitbq >/dev/null 2>&1; then
        return 1
    fi

    # Check if we're completing an append (after colon)
    if [[ "$words[CURRENT]" == *:* ]]; then
        # Split the current word at the colon
        local platform_part="${words[CURRENT]%:*}"
        local append_part="${words[CURRENT]##*:}"

        # Get all available appends
        append_list=(${(f)"$(bitbq self query all-platform-appends 2>/dev/null)"})

        # Output completions in platform:append format
        for append in "${append_list[@]}"; do
            echo "${platform_part}:${append}"
        done
    else
        # Regular platform completion
        platform_list=(${(f)"$(bitbq self query all-platforms 2>/dev/null)"})

        for platform in "${platform_list[@]}"; do
            # Output the platform itself
            echo "${platform}"
            # Also output platform with colon to suggest appends are available
            echo "${platform}:"
        done
    fi
}

__bitbq_append_selector() {
    local appends
    local -a append_list

    if ! command -v bitbq >/dev/null 2>&1; then
        return 1
    fi

    append_list=(${(f)"$(bitbq self query all-platform-appends 2>/dev/null)"})

    for append in "${append_list[@]}"; do
        echo "${append}"
    done
}

# Completion for bitbq keys (group/name or bare unique name).
# - No slash in prefix: offer group/ prefixes (no trailing space) + unique bare names
# - Slash in prefix: offer all full keys (zsh filters by prefix)
__bitbq_all_keys_selector() {
    if ! command -v bitbq >/dev/null 2>&1; then
        return 1
    fi

    if [[ "$words[CURRENT]" == */* ]]; then
        local -a key_list
        key_list=(${(f)"$(bitbq self query all-bitbq-keys 2>/dev/null)"})
        for key in "${key_list[@]}"; do
            echo "${key}"
        done
    else
        local -a group_list name_list
        group_list=(${(f)"$(bitbq self query all-bitbq-groups 2>/dev/null)"})
        name_list=(${(f)"$(bitbq self query unique-bitbq-key-names 2>/dev/null)"})
        # Groups get a trailing slash with no space after it
        compadd -S '/' -q -- "${group_list[@]}" 2>/dev/null
        # Unique bare names complete normally (with trailing space)
        compadd -- "${name_list[@]}" 2>/dev/null
    fi
}

# Completion for bitbq keys whose worktree directory currently exists on disk.
# - No slash in prefix: offer present group/ prefixes (no trailing space) + unique present bare names
# - Slash in prefix: offer all present full keys (zsh filters by prefix)
__bitbq_present_keys_selector() {
    if ! command -v bitbq >/dev/null 2>&1; then
        return 1
    fi

    if [[ "$words[CURRENT]" == */* ]]; then
        local -a key_list
        key_list=(${(f)"$(bitbq self query present-bitbq-keys 2>/dev/null)"})
        for key in "${key_list[@]}"; do
            echo "${key}"
        done
    else
        local -a group_list name_list
        group_list=(${(f)"$(bitbq self query present-bitbq-groups 2>/dev/null)"})
        name_list=(${(f)"$(bitbq self query unique-present-bitbq-key-names 2>/dev/null)"})
        # Groups get a trailing slash with no space after it
        compadd -S '/' -q -- "${group_list[@]}" 2>/dev/null
        # Unique bare names complete normally (with trailing space)
        compadd -- "${name_list[@]}" 2>/dev/null
    fi
}

# Completion for activity exec_id positionals.
__bitbq_exec_id_selector() {
    if ! command -v bitbq >/dev/null 2>&1; then
        return 1
    fi
    local -a ids
    ids=(${(f)"$(bitbq self query live-exec-ids 2>/dev/null)"})
    for id in "${ids[@]}"; do
        echo "${id}"
